<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Application PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<Application authoritative="true" connector="sailpoint.connector.DelimitedFileConnector" featuresString="DIRECT_PERMISSIONS, NO_RANDOM_ACCESS, DISCOVER_SCHEMA" icon="enterpriseIcon" name="Sandbox HR" profileClass="" type="DelimitedFile">
  <Attributes>
    <Map>
      <entry key="delimiter" value=","/>
      <entry key="file" value="C:/IIQSandbox/data/hr_employees.csv"/>
      <entry key="filetransport" value="local"/>
      <entry key="filterEmptyRecords" value="true"/>
      <entry key="hasHeader" value="true"/>
      <entry key="parseType" value="delimited"/>
      <entry key="sysDescriptions">
        <value>
          <Map>
            <entry key="en_US" value="Sandbox demo app loaded from hr_employees.csv"/>
          </Map>
        </value>
      </entry>
    </Map>
  </Attributes>
  <CreationRule>
    <Reference class="sailpoint.object.Rule" name="Sandbox HR Creation"/>
  </CreationRule>
  <Owner>
    <Reference class="sailpoint.object.Identity" name="spadmin"/>
  </Owner>
  <Schemas>
    <Schema displayAttribute="displayName" identityAttribute="employeeId" instanceAttribute="" nativeObjectType="account" objectType="account">
        <AttributeDefinition name="employeeId" type="string"/>
        <AttributeDefinition name="firstName" type="string"/>
        <AttributeDefinition name="lastName" type="string"/>
        <AttributeDefinition name="displayName" type="string"/>
        <AttributeDefinition name="email" type="string"/>
        <AttributeDefinition name="department" type="string"/>
        <AttributeDefinition name="title" type="string"/>
        <AttributeDefinition name="location" type="string"/>
        <AttributeDefinition name="managerId" type="string"/>
        <AttributeDefinition name="employeeType" type="string"/>
        <AttributeDefinition name="status" type="string"/>
        <AttributeDefinition name="hireDate" type="string"/>
    </Schema>
  </Schemas>
</Application>
